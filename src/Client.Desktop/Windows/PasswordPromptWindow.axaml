<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Lumora.Client.Desktop.Windows.PasswordPromptWindow"
        Title="Hasło" Width="340" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <Border Classes="card" Margin="16">
        <StackPanel Spacing="10">
            <TextBlock Name="PromptText" Classes="heading" />
            <TextBox Name="PasswordBox" PasswordChar="•" />
            <TextBlock Name="ErrorText" Foreground="{StaticResource LumoraDanger}" TextWrapping="Wrap" IsVisible="False" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Anuluj" Click="OnCancelClicked" />
                <Button Name="SubmitButton" Content="Dołącz" Classes="accent" Click="OnSubmitClicked" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
