<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lumora.Client.Android.Pages.DrivePage"
             Title="Dysk">
    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="14">

        <Label x:Name="RoomLabel" Grid.Row="0" TextColor="{StaticResource LumoraTextMuted}" FontSize="13" />
        <Button x:Name="UploadButton" Grid.Row="1" Text="Wyślij plik" Clicked="OnUploadClicked"
                HorizontalOptions="Start" />

        <CollectionView x:Name="FilesList" Grid.Row="2" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Usuń" BackgroundColor="{StaticResource LumoraDanger}"
                                           Command="{Binding DeleteCommand}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding Description}"
                                       LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Pobierz" TextColor="{StaticResource LumoraAccent}"
                                       FontAttributes="Bold" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DownloadCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
