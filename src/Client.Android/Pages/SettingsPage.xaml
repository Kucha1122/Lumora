<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lumora.Client.Android.Pages.SettingsPage"
             Title="Ustawienia">
    <VerticalStackLayout Padding="20" Spacing="18">

        <Border Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="4">
                <Label Text="PRZESTRZEŃ" Style="{StaticResource SectionTitle}" />
                <Label x:Name="StatusLabel" FontSize="16" />
            </VerticalStackLayout>
        </Border>

        <Border Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="4">
                <Label Text="SERWER" Style="{StaticResource SectionTitle}" />
                <Label x:Name="ServerAddressLabel" TextColor="{StaticResource LumoraTextMuted}" FontSize="13" />
            </VerticalStackLayout>
        </Border>

        <Border Style="{StaticResource Card}"
                IsVisible="False" x:Name="UpdateCard">
            <VerticalStackLayout Spacing="10">
                <Label Text="AKTUALIZACJA" Style="{StaticResource SectionTitle}" />
                <Label x:Name="UpdateStatusLabel" TextColor="{StaticResource LumoraAccent}" />
                <Button x:Name="UpdateButton" Text="Pobierz i zainstaluj" Clicked="OnUpdateClicked"
                        HorizontalOptions="Start" />
            </VerticalStackLayout>
        </Border>

        <Label x:Name="VersionLabel" TextColor="{StaticResource LumoraTextMuted}" FontSize="12"
               HorizontalOptions="Center" Margin="0,10,0,0" />
    </VerticalStackLayout>
</ContentPage>
