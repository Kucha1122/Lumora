<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lumora.Client.Android.Pages.ClipboardPage"
             Title="Schowek">
    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">

        <Label x:Name="RoomLabel" Grid.Row="0" TextColor="White" FontSize="14" />

        <HorizontalStackLayout Grid.Row="1" Spacing="12">
            <Button x:Name="SendClipboardButton" Text="Wyślij schowek" Clicked="OnSendClipboardClicked" />
            <Button x:Name="ClearButton" Text="Wyczyść historię" Clicked="OnClearClicked" />
        </HorizontalStackLayout>

        <CollectionView x:Name="HistoryList" Grid.Row="2" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Usuń" BackgroundColor="#B23A48"
                                           Command="{Binding DeleteCommand}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Grid Padding="8" ColumnDefinitions="*,Auto"
                              BackgroundColor="#262B52">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Preview}" TextColor="White" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding SubText}" TextColor="#9AA0C3" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="Kopiuj" TextColor="{StaticResource LumoraAccent}"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CopyCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
