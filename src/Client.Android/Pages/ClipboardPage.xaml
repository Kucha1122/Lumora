<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lumora.Client.Android.Pages.ClipboardPage"
             Title="Schowek">
    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="14">

        <Label x:Name="RoomLabel" Grid.Row="0" TextColor="{StaticResource LumoraTextMuted}" FontSize="13" />

        <HorizontalStackLayout Grid.Row="1" Spacing="10">
            <Button x:Name="SendClipboardButton" Text="Wyślij schowek" Clicked="OnSendClipboardClicked" />
            <Button x:Name="ClearButton" Text="Wyczyść" Style="{StaticResource SecondaryButton}" Clicked="OnClearClicked" />
        </HorizontalStackLayout>

        <CollectionView x:Name="HistoryList" Grid.Row="2" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Usuń" BackgroundColor="{StaticResource LumoraDanger}"
                                           Command="{Binding DeleteCommand}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Preview}" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding SubText}" TextColor="{StaticResource LumoraTextMuted}" FontSize="12" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="Kopiuj" TextColor="{StaticResource LumoraAccent}"
                                       FontAttributes="Bold" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding CopyCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
