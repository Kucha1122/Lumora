<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lumora.Client.Android.Pages.RoomsPage"
             Title="Przestrzenie">
    <ScrollView>
        <Grid Padding="16" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">

            <HorizontalStackLayout Grid.Row="0" Spacing="10">
                <Button x:Name="JoinModeButton" Text="Dołącz" Clicked="OnJoinModeClicked" />
                <Button x:Name="CreateModeButton" Text="Utwórz nową" Style="{StaticResource SecondaryButton}"
                        Clicked="OnCreateModeClicked" />
            </HorizontalStackLayout>

            <Label x:Name="ErrorText" Grid.Row="1" TextColor="{StaticResource LumoraDanger}" IsVisible="False" />

            <Border x:Name="CreatePanel" Grid.Row="2" Style="{StaticResource Card}" IsVisible="False">
                <VerticalStackLayout Spacing="10">
                    <Entry x:Name="SlugBox" Placeholder="slug (np. dom, praca)" />
                    <Entry x:Name="DisplayNameBox" Placeholder="Nazwa wyświetlana (opcjonalnie)" />
                    <HorizontalStackLayout Spacing="8">
                        <CheckBox x:Name="PrivateCheckBox" CheckedChanged="OnPrivateCheckedChanged" />
                        <Label Text="Przestrzeń prywatna (hasło)" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Entry x:Name="CreatePasswordBox" Placeholder="Hasło" IsPassword="True" IsVisible="False" />
                    <Button x:Name="CreateSubmitButton" Text="Utwórz i dołącz" Clicked="OnCreateSubmitClicked" />
                </VerticalStackLayout>
            </Border>

            <CollectionView x:Name="RoomsList" Grid.Row="3" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Label Grid.Column="0" Text="{Binding Icon}" VerticalOptions="Center" FontSize="18" />
                                <Label Grid.Column="1" Text="{Binding DisplayName}"
                                       VerticalOptions="Center" Margin="10,0,0,0" />
                                <Label Grid.Column="2" Text="{Binding StatusText}" TextColor="{StaticResource LumoraAccent}"
                                       FontAttributes="Bold" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding JoinCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </ScrollView>
</ContentPage>
