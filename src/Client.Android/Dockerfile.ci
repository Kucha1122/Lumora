# CI build environment for the Android client — not a runnable image, just prepares a
# container with the `android` workload and restored packages so `dotnet publish` (including
# signing) can run inside `docker run`, keeping the self-hosted runner's bare host free of any
# .NET/Android/Java install — same reasoning as src/Api/Dockerfile building the server.
#
# The signing keystore is deliberately NOT copied into this image — it's bind-mounted at
# `docker run` time (see .github/workflows/android.yml) so it never lands in an image layer.
FROM mcr.microsoft.com/dotnet/sdk:10.0
WORKDIR /src

RUN dotnet workload install maui-android --skip-manifest-update

COPY Lumora.slnx ./
COPY src/Client.Android/Lumora.Client.Android.csproj src/Client.Android/
COPY src/Client.Core/Lumora.Client.Core.csproj src/Client.Core/
COPY src/Contracts/Lumora.Contracts.csproj src/Contracts/
RUN dotnet restore src/Client.Android/Lumora.Client.Android.csproj

COPY src/Client.Android/ src/Client.Android/
COPY src/Client.Core/ src/Client.Core/
COPY src/Contracts/ src/Contracts/
