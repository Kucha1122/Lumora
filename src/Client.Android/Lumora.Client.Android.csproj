<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Lumora.Client.Android</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Lumora</ApplicationTitle>
    <ApplicationId>pl.lumora.client</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

    <!-- Etap 2 raises this to Android's current API level per client build; 26 is the
         floor for AndroidClipboardBridge's ClipData image handling via FileProvider. -->
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon and splash use MAUI's default single-project resource pipeline. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1B1F3B" />
    <MauiSplashScreen Include="Resources\AppIcon\appiconfg.svg" Color="#1B1F3B" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.*" />
    <PackageReference Include="Xamarin.AndroidX.Core" Version="1.16.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Client.Core\Lumora.Client.Core.csproj" />
    <ProjectReference Include="..\Contracts\Lumora.Contracts.csproj" />
  </ItemGroup>

</Project>
